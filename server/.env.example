# Copy to .env and fill in for local development.

# SQLite file for local dev. Swap to a Postgres URL in production (Prisma
# supports both — see prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Long random string used to sign auth JWTs.
JWT_SECRET="replace-with-a-long-random-string"

# https://console.anthropic.com/ — powers entry summaries, mood detection,
# and action-item extraction.
ANTHROPIC_API_KEY=""

# https://platform.openai.com/ — used only for Whisper audio transcription
# (Anthropic's API doesn't do speech-to-text).
OPENAI_API_KEY=""

# https://app.revenuecat.com/ project settings → API keys → secret key.
# Used to verify the webhook below and to look up subscribers if needed.
REVENUECAT_WEBHOOK_AUTH_HEADER=""

PORT=4000
